# Telegram Configuration
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890
TELEGRAM_SESSION_STRING=your_session_string_here
TELEGRAM_GROUPS=Group Name 1,Group Name 2,Group Name 3

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=job_notifier

# Scheduler Configuration (milliseconds)
SCHEDULE_INTERVAL_MS=18000000

# LinkedIn RSS URL (optional)
LINKEDIN_RSS_URL=https://news.google.com/rss/search?q=site:linkedin.com/posts+("hiring")&hl=en-IN&gl=IN&ceid=IN:en
