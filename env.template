#####################################################
# JOBKICK - ENVIRONMENT CONFIGURATION TEMPLATE
#####################################################
# 
# Copy this file to .env and fill in your actual values:
#   cp env.template .env
#
# IMPORTANT: Never commit .env to version control!
#
#####################################################

# ==================================================
# DATABASE CONFIGURATION
# ==================================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=job_notifier_db
MYSQL_USER=jobnotifier
MYSQL_PASSWORD=your_secure_database_password_here

# ==================================================
# JWT AUTHENTICATION
# ==================================================
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_64_characters_long_random_string_change_this
JWT_EXPIRATION=86400000

# ==================================================
# AI CONFIGURATION (Google Gemini)
# ==================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
AI_RELEVANCE_THRESHOLD=0.7

# AI Prompt Templates
#AI_PROMPT_TEMPLATE=Analyze the following job posting and user preferences. Extract structured information and score the relevance from 0 to 1.\n\nJob Posting (may be in any format - text, structured, or mixed):\n{job}\n\nUser Preferences:\nRole Looking For: {role}\nSkills: {skills}\nCity: {city}\nSalary: {salary}\nCompanies: {companies}\nExperience: {experience}\nNotice Period: {noticePeriod}\nEducation: {education}\n\nTasks:\n1. CAREFULLY extract ALL job information from the posting including role/position, company, batch/graduation year requirements, job type (Full-Time/Internship/etc), application deadline, duration if internship, and comprehensive description\n2. Analyze how well this job matches the user preferences (consider role match, skills alignment, location, salary, company preference, experience level, education background, and notice period)\n3. Provide a relevance score from 0 to 1 based on ALL user preferences. SCORING GUIDELINES:\n   - Role/skills match is the MOST important factor (weight ~50%). If the role and core skills match well, the score should be at least 0.5.\n   - Experience: Be lenient — if the difference between user experience and required experience is 1 year or less, treat it as a FULL match. Even a 2-year gap should only slightly reduce the score.\n   - Location: If user prefers Remote or the job is Remote/WFH, treat as a match. Different cities should reduce score only moderately (not drastically).\n   - Salary: If the job posting does not mention salary, do NOT penalize the score. Only reduce if the posted salary is clearly below user expectation.\n   - Companies: If user has no company preference (or "Any"), do not penalize. Only reduce if user specifically listed preferred companies and this company is very different.\n   - Notice Period: Minor mismatches (e.g., 15 days vs immediate) should not significantly reduce the score.\n   - Overall: Be GENEROUS with scoring. A job that matches the role and most skills should score 0.6+ even if other preferences partially differ. Only give scores below 0.3 if the role/skills are completely unrelated.\n4. For the jobLink field, follow these rules strictly:\n   - If the posting contains an OFFICIAL application link (directly from the company's domain, e.g., careers.google.com, jobs.microsoft.com, company.workday.com), use that exact URL.\n   - An official link means it is hosted on the HIRING COMPANY's own domain (e.g., careers.google.com, jobs.lever.co/company, company.workday.com). LinkedIn posts, LinkedIn job listings, and third-party job boards are NOT official.\n   - REJECT all of these: bit.ly, t.me, telegram links, tinyurl, linktr.ee, linkedin.com/posts, linkedin.com/jobs, internshipss.com, instahyre.com, internshala.com, naukri.com, indeed.com, glassdoor.com, and any other job aggregator or social media link.\n   - If NO official company-hosted link is found, you MUST generate the company's official careers page URL. For example: for Google use "https://careers.google.com", for Microsoft use "https://careers.microsoft.com", for Amazon use "https://www.amazon.jobs", for Salesforce use "https://careers.salesforce.com", for TCS use "https://www.tcs.com/careers". Use the format "https://[company-domain]/careers" or the well-known careers URL for that company.\n   - The jobLink field must NEVER be null - always provide either the official link from the posting or the company's careers page URL.\n\nCRITICAL: The job posting may come from Telegram channels or other aggregators. NEVER include the source channel name, group name, or any aggregator metadata in your response. Do NOT reference phrases like 'Off Campus Drive', channel names, or forwarding info in any field. Extract ONLY the actual job details. If a field value can only be guessed from the source/channel name rather than the actual job content, use the default value instead.\n\nIMPORTANT: You MUST provide ALL fields in the JSON response. If information is not found in the job posting, use these defaults:\n- For 'role': try to infer from job description or use "Not specified"\n- For 'batch': null if not mentioned\n- For 'jobType': infer from context (look for keywords like internship, full-time, contract) or use "Full-Time" as default\n- For 'deadline': must be in yyyy-MM-dd format (e.g., 2025-12-31). Convert any date mentioned to this format. Use null if not mentioned.\n- For 'duration': null if not internship or not mentioned\n\nProvide ONLY a valid JSON response (no markdown, no extra text) with these exact keys:\n{\n  "score": number between 0 and 1,\n  "reason": "explanation of the score",\n  "company": "company name",\n  "role": "job title/position",\n  "experience": "required experience",\n  "location": "job location/city",\n  "salary": "salary range or amount",\n  "batch": "graduation year if mentioned, otherwise null",\n  "jobType": "Full-Time or Internship or Part-Time or Contract",\n  "deadline": "deadline in yyyy-MM-dd format if mentioned, otherwise null",\n  "duration": "duration if internship, otherwise null",\n  "description": "comprehensive job description with all details",\n  "jobLink": "official application URL or company careers page URL (NEVER null)"\n}

Analyze the following job posting and user preferences. Extract structured information and score the relevance from 0 to 1. Job Posting (may be in any format - text, structured, or mixed): {job} User Preferences: Role Looking For: {role}, Skills: {skills}, City: {city}, Salary: {salary}, Companies: {companies}, Experience: {experience}, Notice Period: {noticePeriod}, Education: {education}. Tasks: 1) Carefully extract ALL job information including role/position, company, batch/graduation year requirements, job type (Full-Time/Internship/etc), application deadline, duration (if internship), required skills/technologies, location, salary (if mentioned), and comprehensive description. 2) Analyze match based on role (MOST IMPORTANT), skills (MOST IMPORTANT), experience, location, salary, company preference, education, and notice period. 3) Provide a relevance score (0–1) using STRICT scoring: Role+Skills≈50%, Experience≈15%, Location≈10%, Salary≈10%, Company≈5%, Others≈10%. CRITICAL RULES: If role/title missing, unclear, or cannot be inferred → score MUST be ≤0.3; if required skills/tech stack missing → reduce score significantly; if description is vague/meaningless → score MUST be ≤0.3; if more than 50% of key fields (role, skills, company, description) are missing → score MUST be between 0.0–0.3; NEVER assume relevance when info is missing; DO NOT give benefit of doubt for incomplete postings. ROLE/SKILL MATCH: strong match → ≥0.6; partial → 0.4–0.6; weak/unrelated → ≤0.3. EXPERIENCE: ≤1 year gap = full match, 2-year gap = slight penalty only. LOCATION: remote/WFH = match, different city = moderate penalty only. SALARY: if not mentioned → no penalty; if clearly below expectation → reduce score. COMPANY: if no preference → no penalty; penalize only if user specified companies and mismatch. FINAL GUARDRAILS: score ≥0.7 ONLY if role+skills clearly aligned AND job details are complete; 0.4–0.6 for partial matches; ≤0.3 for vague/incomplete/unrelated jobs. 4) jobLink rules: use ONLY official company-hosted links (e.g., careers.google.com, jobs.microsoft.com, company.workday.com); REJECT all aggregator/social links (LinkedIn, Naukri, Indeed, Telegram, etc.); if no official link present → generate company careers page URL; jobLink must NEVER be null. 5) Ignore Telegram/LinkedIn/channel metadata; extract ONLY actual job content; if any field cannot be determined → use defaults. DEFAULTS: role="Not specified", batch=null, jobType="Full-Time", deadline=null, duration=null, experience="Not specified", location="Not specified", salary="Not specified", company="Not specified". OUTPUT: Provide ONLY valid JSON (no markdown, no extra text): {"score": number between 0 and 1, "reason": "explanation including mention of missing/unclear fields if any", "company": "company name", "role": "job title/position", "experience": "required experience", "location": "job location/city", "salary": "salary range or amount", "batch": "graduation year if mentioned, otherwise null", "jobType": "Full-Time or Internship or Part-Time or Contract", "deadline": "yyyy-MM-dd or null", "duration": "internship duration or null", "description": "comprehensive job description", "jobLink": "official application URL or generated careers page (NEVER null)"}
AI_RESUME_MODIFICATION_PROMPT=You are a resume customization assistant. Your task is to make MINIMAL modifications to the provided LaTeX resume to better align it with the job posting.\n\nIMPORTANT RULES:\n1. DO NOT change the resume structure, formatting, or layout\n2. DO NOT remove any existing content\n3. DO NOT change section names or organization\n4. ONLY add relevant skills that are mentioned in the job posting but missing from the resume\n5. Keep all existing skills, experiences, and details exactly as they are\n6. Only make minor additions - add 1-3 relevant skills maximum if they are clearly mentioned in the job requirements\n7. Preserve all LaTeX commands, formatting, and structure exactly as provided\n8. Return ONLY the modified LaTeX code without any explanations or markdown\n\nJob Posting:\n{job}\n\nOriginal Resume LaTeX:\n{resumeLatex}\n\nReturn the modified LaTeX resume with minimal changes - only adding missing relevant skills if needed. Do not add explanations, just return the LaTeX code.

# ==================================================
# OPENROUTER - Primary AI provider when enabled
# ==================================================
# Get your API key from: https://openrouter.ai/keys
# Set OPENROUTER_ENABLED=true to use OpenRouter as primary
# Falls back to Gemini → Groq if OpenRouter fails
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api

# ==================================================
# GROQ - Fallback AI when Gemini fails
# ==================================================
# Get your API key from: https://console.groq.com/keys
# Leave empty to disable Groq fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==================================================
# GOOGLE OAUTH
# ==================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==================================================
# CLOUDINARY
# ==================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================================================
# EMAIL (Gmail SMTP)
# ==================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password_here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000

# ==================================================
# LATEX COMPILER
# ==================================================
LATEX_COMPILER_URL=https://latex.ytotech.com/builds/sync
LATEX_TIMEOUT=30000

# ==================================================
# SCHEDULER
# ==================================================
SCHEDULER_FIXED_RATE=60000
SCHEDULER_ENABLED=true
SCHEDULER_DEADLINE_REMINDER_CRON=0 15 12 * * ?
SCHEDULER_DEADLINE_REMINDER_ENABLED=true
# Daily pending jobs digest email (default: 9:00 AM daily)
SCHEDULER_PENDING_DIGEST_CRON=0 0 9 * * ?
SCHEDULER_PENDING_DIGEST_ENABLED=true
# User engagement emails (nudge to create/complete notifiers)
SCHEDULER_ENGAGEMENT_CRON=0 0 10 * * ?
SCHEDULER_ENGAGEMENT_ENABLED=true
# How often engagement emails are sent (in days). Cron still runs daily but skips if last send was within this window.
SCHEDULER_ENGAGEMENT_FREQUENCY_DAYS=2
SCHEDULER_NOTIFICATION_CLEANUP_CRON=0 27 23 * * ?
SCHEDULER_NOTIFICATION_CLEANUP_DAYS_THRESHOLD=10
NOTIFICATION_CLEANUP_ENABLED=true

# ==================================================
# NOTIFIER
# ==================================================
NOTIFIER_MAX_PER_USER=5
# Number of recent jobs to check when a new notifier is created
NOTIFIER_BACKFILL_JOB_COUNT=50
# Max age of jobs to include in backfill (skip older + expired deadline jobs)
NOTIFIER_BACKFILL_MAX_AGE_DAYS=7

# ==================================================
# RATE LIMITING
# ==================================================
RATE_LIMIT_RESUME_UPDATE_COOLDOWN_MINUTES=60
RATE_LIMIT_RESUME_UPDATE_COOLDOWN_TIMES=2
RATE_LIMIT_FORGOT_PASSWORD_COOLDOWN_MINUTES=2

# ==================================================
# FRONTEND
# ==================================================
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_ENABLE_BACKEND_API=true
FRONTEND_URL=http://localhost:5173

# ==================================================
# JOBS FETCHER (Telegram)
# ==================================================
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890
TELEGRAM_SESSION_STRING=
TELEGRAM_GROUPS=@jobchannel1,@jobchannel2
SCHEDULE_INTERVAL_MS=300000

# Get your Jooble API key from: https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key_here
JOOBLE_KEYWORDS=python developer
JOOBLE_LOCATION=
SCHEDULE_INTERVAL_MS=7200000

# LinkedIn RSS URL (optional - for fetching LinkedIn job posts via Google News RSS)
LINKEDIN_RSS_URL=https://news.google.com/rss/search?q=site:linkedin.com/posts+("hiring")&hl=en-IN&gl=IN&ceid=IN:en

# ==================================================
# LOGGING
# ==================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_JOBNOTIFER=INFO
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=prod

# ==================================================
# BUILD (Optional)
# ==================================================
BUILD_DATE=2025-01-01
VERSION=1.0.0

