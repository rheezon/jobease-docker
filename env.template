#####################################################
# JOBEASE - ENVIRONMENT CONFIGURATION TEMPLATE
#####################################################
# 
# Copy this file to .env and fill in your actual values:
#   cp env.template .env
#
# IMPORTANT: Never commit .env to version control!
#
#####################################################

# ==================================================
# DATABASE CONFIGURATION
# ==================================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=job_notifier_db
MYSQL_USER=jobnotifier
MYSQL_PASSWORD=your_secure_database_password_here

# ==================================================
# JWT AUTHENTICATION
# ==================================================
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_64_characters_long_random_string_change_this
JWT_EXPIRATION=86400000

# ==================================================
# AI CONFIGURATION (Google Gemini)
# ==================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
AI_RELEVANCE_THRESHOLD=0.7

# ==================================================
# GOOGLE OAUTH
# ==================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==================================================
# CLOUDINARY
# ==================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================================================
# EMAIL (Gmail SMTP)
# ==================================================
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password_here

# ==================================================
# LATEX COMPILER
# ==================================================
LATEX_COMPILER_URL=https://latex.ytotech.com/builds/sync
LATEX_TIMEOUT=30000

# ==================================================
# SCHEDULER
# ==================================================
SCHEDULER_FIXED_RATE=60000
SCHEDULER_ENABLED=true
SCHEDULER_DEADLINE_REMINDER_ENABLED=true
NOTIFICATION_CLEANUP_ENABLED=true

# ==================================================
# NOTIFIER
# ==================================================
NOTIFIER_MAX_PER_USER=5

# ==================================================
# FRONTEND
# ==================================================
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_ENABLE_BACKEND_API=true
FRONTEND_URL=http://localhost:5173

# ==================================================
# JOBS FETCHER (Telegram)
# ==================================================
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890
TELEGRAM_SESSION_STRING=
TELEGRAM_GROUPS=@jobchannel1,@jobchannel2
SCHEDULE_INTERVAL_MS=300000

# ==================================================
# LOGGING
# ==================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_JOBNOTIFER=INFO
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=prod

# ==================================================
# BUILD (Optional)
# ==================================================
BUILD_DATE=2025-01-01
VERSION=1.0.0

