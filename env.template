#####################################################
# JOBKICK - ENVIRONMENT CONFIGURATION TEMPLATE
#####################################################
# 
# Copy this file to .env and fill in your actual values:
#   cp env.template .env
#
# IMPORTANT: Never commit .env to version control!
#
#####################################################

# ==================================================
# DATABASE CONFIGURATION
# ==================================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=job_notifier_db
MYSQL_USER=jobnotifier
MYSQL_PASSWORD=your_secure_database_password_here

# ==================================================
# JWT AUTHENTICATION
# ==================================================
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_64_characters_long_random_string_change_this
JWT_EXPIRATION=86400000

# ==================================================
# AI CONFIGURATION (Google Gemini)
# ==================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
AI_RELEVANCE_THRESHOLD=0.7

# AI Prompt Templates
AI_PROMPT_TEMPLATE=Analyze the following job posting and user preferences. Extract structured information and score the relevance from 0 to 1.\n\nJob Posting (may be in any format - text, structured, or mixed):\n{job}\n\nUser Preferences:\nRole Looking For: {role}\nSkills: {skills}\nCity: {city}\nSalary: {salary}\nCompanies: {companies}\nExperience: {experience}\nNotice Period: {noticePeriod}\nEducation: {education}\n\nTasks:\n1. CAREFULLY extract ALL job information from the posting including role/position, company, batch/graduation year requirements, job type (Full-Time/Internship/etc), application deadline, duration if internship, and comprehensive description\n2. Analyze how well this job matches the user preferences (consider role match, skills alignment, location, salary, company preference, experience level, education background, and notice period)\n3. Provide a relevance score from 0 to 1 based on ALL user preferences\n4. Extract job application link if available\n\nCRITICAL: The job posting may come from Telegram channels or other aggregators. NEVER include the source channel name, group name, or any aggregator metadata in your response. Do NOT reference phrases like 'Off Campus Drive', channel names, or forwarding info in any field. Extract ONLY the actual job details. If a field value can only be guessed from the source/channel name rather than the actual job content, use the default value instead.\n\nIMPORTANT: You MUST provide ALL fields in the JSON response. If information is not found in the job posting, use these defaults:\n- For 'role': try to infer from job description or use "Not specified"\n- For 'batch': null if not mentioned\n- For 'jobType': infer from context (look for keywords like internship, full-time, contract) or use "Full-Time" as default\n- For 'deadline': must be in yyyy-MM-dd format (e.g., 2025-12-31). Convert any date mentioned to this format. Use null if not mentioned.\n- For 'duration': null if not internship or not mentioned\n\nProvide ONLY a valid JSON response (no markdown, no extra text) with these exact keys:\n{\n  "score": number between 0 and 1,\n  "reason": "explanation of the score",\n  "company": "company name",\n  "role": "job title/position",\n  "experience": "required experience",\n  "location": "job location/city",\n  "salary": "salary range or amount",\n  "batch": "graduation year if mentioned, otherwise null",\n  "jobType": "Full-Time or Internship or Part-Time or Contract",\n  "deadline": "deadline in yyyy-MM-dd format if mentioned, otherwise null",\n  "duration": "duration if internship, otherwise null",\n  "description": "comprehensive job description with all details",\n  "jobLink": "URL if found, otherwise null"\n}

AI_RESUME_MODIFICATION_PROMPT=You are a resume customization assistant. Your task is to make MINIMAL modifications to the provided LaTeX resume to better align it with the job posting.\n\nIMPORTANT RULES:\n1. DO NOT change the resume structure, formatting, or layout\n2. DO NOT remove any existing content\n3. DO NOT change section names or organization\n4. ONLY add relevant skills that are mentioned in the job posting but missing from the resume\n5. Keep all existing skills, experiences, and details exactly as they are\n6. Only make minor additions - add 1-3 relevant skills maximum if they are clearly mentioned in the job requirements\n7. Preserve all LaTeX commands, formatting, and structure exactly as provided\n8. Return ONLY the modified LaTeX code without any explanations or markdown\n\nJob Posting:\n{job}\n\nOriginal Resume LaTeX:\n{resumeLatex}\n\nReturn the modified LaTeX resume with minimal changes - only adding missing relevant skills if needed. Do not add explanations, just return the LaTeX code.

# ==================================================
# GOOGLE OAUTH
# ==================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==================================================
# CLOUDINARY
# ==================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================================================
# EMAIL (Gmail SMTP)
# ==================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password_here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000

# ==================================================
# LATEX COMPILER
# ==================================================
LATEX_COMPILER_URL=https://latex.ytotech.com/builds/sync
LATEX_TIMEOUT=30000

# ==================================================
# SCHEDULER
# ==================================================
SCHEDULER_FIXED_RATE=60000
SCHEDULER_ENABLED=true
SCHEDULER_DEADLINE_REMINDER_CRON=0 15 12 * * ?
SCHEDULER_DEADLINE_REMINDER_ENABLED=true
SCHEDULER_NOTIFICATION_CLEANUP_CRON=0 27 23 * * ?
SCHEDULER_NOTIFICATION_CLEANUP_DAYS_THRESHOLD=10
NOTIFICATION_CLEANUP_ENABLED=true

# ==================================================
# NOTIFIER
# ==================================================
NOTIFIER_MAX_PER_USER=5

# ==================================================
# RATE LIMITING
# ==================================================
RATE_LIMIT_RESUME_UPDATE_COOLDOWN_MINUTES=60
RATE_LIMIT_RESUME_UPDATE_COOLDOWN_TIMES=2
RATE_LIMIT_FORGOT_PASSWORD_COOLDOWN_MINUTES=2

# ==================================================
# FRONTEND
# ==================================================
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_ENABLE_BACKEND_API=true
FRONTEND_URL=http://localhost:5173

# ==================================================
# JOBS FETCHER (Telegram)
# ==================================================
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890
TELEGRAM_SESSION_STRING=
TELEGRAM_GROUPS=@jobchannel1,@jobchannel2
SCHEDULE_INTERVAL_MS=300000

# Get your Jooble API key from: https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key_here
JOOBLE_KEYWORDS=python developer
JOOBLE_LOCATION=
SCHEDULE_INTERVAL_MS=7200000

# ==================================================
# LOGGING
# ==================================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_JOBNOTIFER=INFO
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=prod

# ==================================================
# BUILD (Optional)
# ==================================================
BUILD_DATE=2025-01-01
VERSION=1.0.0

